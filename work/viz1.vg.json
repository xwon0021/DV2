{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 650,
  "projection": {
    "type": "mercator"
  },
  "usermeta": {
    "notes": "Zoom: Mercator turns SA2 coordinates into map shapes. After this JSON loads, addMapNavigation adds mapZoom and mapPan; the shapes scale and move with these signals. Reset sets them to 1 and [0, 0]."
  },
  "data": {
    "url": "work/data/SA2_2021_AUST_GDA2020_web.json",
    "format": {
      "type": "topojson",
      "feature": "SA2_2021_AUST_GDA2020"
    }
  },
  "transform": [
    {
      "lookup": "properties.SA2_CODE21",
      "from": {
        "data": {
          "url": "work/data/vis01_sa2_rate.csv",
          "format": {
            "type": "csv",
            "parse": {
              "SA2_Code": "string",
              "Manufacturing_Businesses": "number",
              "Population_2025": "number",
              "Businesses_per_10000": "number",
              "Year": "number"
            }
          }
        },
        "key": "SA2_Code",
        "fields": [
          "SA2_Name",
          "State",
          "Manufacturing_Businesses",
          "Population_2025",
          "Businesses_per_10000",
          "Year",
          "Rate_Status"
        ]
      }
    },
    {
      "calculate": "datum.Rate_Status === 'valid' ? datum.Businesses_per_10000 : null",
      "as": "Businesses_per_10000"
    },
    {
      "calculate": "datum.Rate_Status === 'missing_business_total' || !isValid(datum.Rate_Status) ? null : datum.Manufacturing_Businesses",
      "as": "Manufacturing_Businesses"
    },
    {
      "calculate": "datum.Rate_Status === 'valid' ? format(datum.Businesses_per_10000, ',.1f') : 'Unavailable (missing count or zero population)'",
      "as": "Rate_Display"
    },
    {
      "calculate": "isValid(datum.SA2_Name) ? datum.SA2_Name : datum.properties.SA2_NAME21",
      "as": "SA2_Display"
    },
    {
      "calculate": "isValid(datum.State) ? datum.State : 'Unavailable (no linked record)'",
      "as": "State_Display"
    },
    {
      "calculate": "isValid(datum.Manufacturing_Businesses) ? format(datum.Manufacturing_Businesses, ',.0f') : 'Unavailable'",
      "as": "Count_Display"
    },
    {
      "calculate": "isValid(datum.Population_2025) ? format(datum.Population_2025, ',.0f') : 'Unavailable'",
      "as": "Population_Display"
    },
    {
      "calculate": "isValid(datum.Year) ? datum.Year : 'Not linked'",
      "as": "Year_Display"
    },
    {
      "calculate": "isValid(datum.Businesses_per_10000) ? (datum.Businesses_per_10000 < 16.619744185432076 ? 0 : (datum.Businesses_per_10000 < 25.69467417275979 ? 1 : (datum.Businesses_per_10000 < 38.732133634894126 ? 2 : (datum.Businesses_per_10000 < 58.332291739375385 ? 3 : (datum.Businesses_per_10000 < 89.35125844791428 ? 4 : (datum.Businesses_per_10000 < 6010.714285714259 ? 5 : (6))))))) : null",
      "as": "Rate_Class"
    }
  ],
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "Arial, sans-serif"
  },
  "layer": [
    {
      "description": "Notes: Draw SA2 areas without a valid rate in grey so missing data is not shown as a real value.",
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 0.24
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "selectedRateClass >= 0",
            "value": "#BCC4CC"
          },
          "value": "#e4e8ec"
        },
        "tooltip": [
          {
            "field": "SA2_Display",
            "type": "nominal",
            "title": "SA2"
          },
          {
            "field": "State_Display",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "Count_Display",
            "type": "nominal",
            "title": "Manufacturing businesses"
          },
          {
            "field": "Population_Display",
            "type": "nominal",
            "title": "Population (2025)"
          },
          {
            "field": "Rate_Display",
            "type": "nominal",
            "title": "Businesses per 10,000 residents"
          },
          {
            "field": "Year_Display",
            "type": "nominal",
            "title": "Business-count year"
          }
        ]
      },
      "transform": [
        {
          "filter": "!isValid(datum.Businesses_per_10000)"
        }
      ]
    },
    {
      "description": "Notes: Draw valid SA2 rates. The threshold scale chooses the colour.\nselectedRateClass fades other Rate_Class groups; rateHover highlights the hovered area.",
      "transform": [
        {
          "filter": "isValid(datum.Businesses_per_10000)"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 0.24
      },
      "encoding": {
        "color": {
          "field": "Businesses_per_10000",
          "type": "quantitative",
          "scale": {
            "type": "threshold",
            "domain": [
              16.619744185432076,
              25.69467417275979,
              38.732133634894126,
              58.332291739375385,
              89.35125844791428,
              6010.714285714259
            ],
            "range": [
          "#F6F1DE",
          "#C9DBC5",
          "#86BCBB",
          "#4795B1",
          "#286B9A",
          "#254573",
          "#191E43"
            ]
          },
          "legend": null,
          "condition": {
            "test": "selectedRateClass >= 0 && datum.Rate_Class !== selectedRateClass",
            "value": "#E6E8EB"
          }
        },
        "tooltip": [
          {
            "field": "SA2_Display",
            "type": "nominal",
            "title": "SA2"
          },
          {
            "field": "State_Display",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "Count_Display",
            "type": "nominal",
            "title": "Manufacturing businesses"
          },
          {
            "field": "Population_Display",
            "type": "nominal",
            "title": "Population (2025)"
          },
          {
            "field": "Rate_Display",
            "type": "nominal",
            "title": "Businesses per 10,000 residents"
          },
          {
            "field": "Year_Display",
            "type": "nominal",
            "title": "Business-count year"
          }
        ],
        "stroke": {
          "condition": {
            "param": "rateHover",
            "empty": false,
            "value": "#A76312"
          },
          "value": "#ffffff"
        },
        "strokeWidth": {
          "condition": [
            {
              "test": "selectedRateClass >= 0 && datum.Rate_Class === selectedRateClass && rateHover.SA2_Display && indexof(rateHover.SA2_Display, datum.SA2_Display) >= 0",
              "value": 3
            },
            {
              "param": "rateHover",
              "empty": false,
              "value": 1.25
            }
          ],
          "value": 0.24
        }
      },
      "params": [
        {
          "name": "rateHover",
          "select": {
            "type": "point",
            "fields": [
              "SA2_Display"
            ],
            "on": "pointerover",
            "clear": "pointerout",
            "toggle": false
          }
        }
      ]
    }
  ],
  "params": [
    {
      "name": "selectedRateClass",
      "value": -1
    }
  ]
}
