{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 650,
  "data": {
    "notes": "One industry per CSV row. Growth rates compare 2023–24 with 2024–25.",
    "url": "work/data/vis06_sales_vs_iva_growth.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Sales_Growth_pct": "number",
        "IVA_Growth_pct": "number",
        "ANZSIC_Code": "number"
      }
    }
  },
  "transform": [
    {
      "notes": "Make one sales bar and one IVA bar from each CSV row.",
      "fold": [
        "Sales_Growth_pct",
        "IVA_Growth_pct"
      ],
      "as": [
        "Measure",
        "Growth"
      ]
    },
    {
      "notes": "Do not draw a bar when the growth value is missing.",
      "filter": "isValid(datum.Growth)"
    },
    {
      "calculate": "datum.Measure === 'Sales_Growth_pct' ? 'Sales / service income' : 'Industry value added'",
      "as": "Measure_Label"
    }
  ],
  "mark": {
    "notes": "Draw a bar for each available growth value.",
    "type": "bar",
    "cornerRadiusEnd": 2
  },
  "encoding": {
    "x": {
      "notes": "Growth below zero goes left; growth above zero goes right.",
      "field": "Growth",
      "type": "quantitative",
      "scale": {
        "domain": [
          -15,
          30
        ]
      },
      "title": "Year-on-year growth (%)"
    },
    "y": {
      "notes": "Put each manufacturing industry on a separate row.",
      "field": "Subdivision_Short",
      "type": "nominal",
      "sort": {
        "field": "ANZSIC_Code",
        "op": "min",
        "order": "ascending"
      },
      "axis": {
        "title": null,
        "labelLimit": 200
      }
    },
    "yOffset": {
      "notes": "Place its sales and IVA bars side by side.",
      "field": "Measure_Label",
      "sort": [
        "Sales / service income",
        "Industry value added"
      ]
    },
    "color": {
      "notes": "Teal is sales growth. Orange is IVA growth, matching V4.",
      "field": "Measure_Label",
      "type": "nominal",
      "scale": {
        "domain": [
          "Sales / service income",
          "Industry value added"
        ],
        "range": [
          "#16877B",
          "#D95F02"
        ]
      },
      "legend": {
        "orient": "bottom",
        "title": null
      }
    },
    "tooltip": [
      {
        "notes": "Hover a bar for the exact industry, measure and growth rate.",
        "field": "Subdivision",
        "title": "Subdivision"
      },
      {
        "field": "Measure_Label",
        "title": "Measure"
      },
      {
        "field": "Growth",
        "title": "2023–24 to2024–25 growth (%)",
        "format": ".2f"
      }
    ]
  },
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "Arial, sans-serif",
    "axis": {
      "labelColor": "#43596c",
      "titleColor": "#43596c",
      "gridColor": "#edf1f4",
      "domainColor": "#ccd6de",
      "tickColor": "#ccd6de"
    },
    "legend": {
      "labelColor": "#43596c",
      "titleColor": "#43596c",
      "labelFontSize": 11
    }
  }
}
