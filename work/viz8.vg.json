{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "Arial",
    "axis": {
      "labelColor": "#43596c",
      "titleColor": "#43596c",
      "gridColor": "#edf1f4",
      "labelFontSize": 11,
      "titleFontSize": 11
    }
  },
  "data": {
    "notes": "One JSON record per financial year: its June-end date and employment in thousands.",
    "url": "work/data/vis08_national_employment_overview.json"
  },
  "vconcat": [
    {
      "width": "container",
      "height": 280,
      "notes": "Top chart: show the selected years in more detail.",
      "encoding": {
        "x": {
          "notes": "The date goes along the bottom. The lower brush chooses which dates appear here.",
          "field": "Date",
          "type": "temporal",
          "axis": {
            "title": "Financial year ending June",
            "format": "%Y",
            "tickCount": {
              "expr": "span(domain('concat_0_x')) < 6 * 365.25 * 86400000 ? {interval: 'year', step: 1} : {interval: 'year', step: 5}"
            }
          },
          "scale": {
            "domain": {
              "param": "brush"
            }
          }
        },
        "y": {
          "notes": "The height shows people employed, in thousands.",
          "field": "Employment_Thousands",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1100
            ]
          },
          "axis": {
            "title": "Employment (thousands)",
            "tickCount": 5
          }
        }
      },
      "layer": [
        {
          "mark": {
            "type": "area",
            "color": "#2C7FB8",
            "opacity": 0.09,
            "clip": true
          }
        },
        {
          "mark": {
            "type": "line",
            "color": "#2C7FB8",
            "strokeWidth": 2.5,
            "clip": true
          }
        },
        {
          "mark": {
            "type": "point",
            "notes": "Draw each observed year as a dot. Hover for the value or click to inspect that year.",
            "filled": true,
            "color": "#2C7FB8",
            "size": 160,
            "opacity": 1,
            "clip": true
          },
          "encoding": {
            "size": {
              "condition": {
                "param": "employmentPoint",
                "empty": false,
                "value": 360
              },
              "value": 160
            },
            "fill": {
              "condition": {
                "param": "employmentPoint",
                "empty": false,
                "value": "#A76312"
              },
              "value": "#2C7FB8"
            },
            "tooltip": [
              {
                "field": "Financial_Year_Display",
                "title": "Financial year"
              },
              {
                "field": "Employment_Thousands",
                "title": "Employment at June end (thousands)",
                "format": ",.1f"
              }
            ],
            "stroke": {
              "condition": {
                "param": "employmentPoint",
                "empty": false,
                "value": "#A76312"
              },
              "value": "#ffffff"
            },
            "strokeWidth": {
              "condition": {
                "param": "employmentPoint",
                "empty": false,
                "value": 3
              },
              "value": 1.5
            }
          },
          "params": [
            {
              "name": "employmentPoint",
              "notes": "Remember the year when someone clicks its dot.",
              "select": {
                "type": "point",
                "fields": [
                  "Financial_Year"
                ],
                "toggle": false,
                "clear": false,
                "nearest": true
              }
            }
          ]
        },
        {
          "transform": [
            {
              "filter": "datum.Year_Order == 13"
            }
          ],
          "mark": {
            "type": "text",
            "align": "center",
            "dy": 20,
            "fontSize": 11,
            "color": "#43596c",
            "clip": true
          },
          "encoding": {
            "text": {
              "datum": "2019\u20132020 minimum: 830.2k"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.Year_Order == 18"
            }
          ],
          "mark": {
            "type": "text",
            "align": "right",
            "dy": -18,
            "fontSize": 11,
            "color": "#43596c",
            "clip": true
          },
          "encoding": {
            "text": {
              "datum": "2024\u20132025: 900.8k"
            }
          }
        }
      ]
    },
    {
      "width": "container",
      "height": 90,
      "notes": "Bottom chart: show the whole history so you can choose a period.",
      "params": [
        {
          "name": "brush",
          "notes": "Drag across the lower chart to pick years. Double-click to clear the brush.",
          "select": {
            "type": "interval",
            "encodings": [
              "x"
            ],
            "mark": {
              "fill": "#A76312",
              "fillOpacity": 0.14,
              "stroke": "#A76312",
              "strokeWidth": 2
            }
          }
        }
      ],
      "mark": {
        "type": "area",
        "color": "#2C7FB8",
        "opacity": 0.25
      },
      "encoding": {
        "x": {
          "field": "Date",
          "type": "temporal",
          "axis": {
            "title": "Drag to select years",
            "format": "%Y",
            "tickCount": 5
          }
        },
        "y": {
          "field": "Employment_Thousands",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1100
            ]
          },
          "axis": {
            "title": null,
            "tickCount": 3,
            "grid": false,
            "format": ",.0f"
          }
        }
      },
      "name": "employmentOverview"
    }
  ],
  "params": [
    {
      "name": "periodStart",
      "notes": "JavaScript sets this when the Start year dropdown changes.",
      "value": null
    },
    {
      "name": "periodEnd",
      "notes": "JavaScript sets this when the End year dropdown changes.",
      "value": null
    }
  ],
  "transform": [
    {
      "calculate": "substring(datum.Financial_Year, 0, 4) + '\u2013' + format(toNumber(substring(datum.Financial_Year, 0, 4)) + 1, 'd')",
      "as": "Financial_Year_Display"
    }
  ]
}
