{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "width": 900,
  "height": 600,
  "padding": 5,
  "autosize": {
    "type": "none",
    "contains": "padding"
  },
  "background": "transparent",
  "signals": [
    {
      "name": "hoverCode",
      "value": null,
      "on": [
        {
          "events": "@slopes:mouseover, @endpoints:mouseover, @labels:mouseover, @rightEndpoints:mouseover, @rightLabels:mouseover",
          "update": "datum.Code"
        },
        {
          "events": "@slopes:mouseout, @endpoints:mouseout, @labels:mouseout, @rightEndpoints:mouseout, @rightLabels:mouseout",
          "update": "null"
        }
      ]
    },
    {
      "name": "focusCode",
      "value": null
    }
  ],
  "data": [
    {
      "name": "iva",
      "url": "work/data/vis10_industry_value_added.json"
    }
  ],
  "scales": [
    {
      "name": "y",
      "type": "linear",
      "domain": [
        0,
        34000
      ],
      "range": [
        540,
        40
      ],
      "zero": true
    }
  ],
  "marks": [
    {
      "name": "slopes",
      "type": "rule",
      "from": {
        "data": "iva"
      },
      "encode": {
        "update": {
          "x": {
            "value": 240
          },
          "x2": {
            "signal": "width-240"
          },
          "y": {
            "scale": "y",
            "field": "IVA_2023_24"
          },
          "y2": {
            "scale": "y",
            "field": "IVA_2024_25"
          },
          "stroke": {
            "signal": "((hoverCode || focusCode) ? datum.Code === (hoverCode || focusCode) : datum.Highlight) ? (datum.Code === '13' ? '#C62828' : '#D8891C') : '#718699'"
          },
          "strokeWidth": {
            "signal": "((hoverCode || focusCode) ? datum.Code === (hoverCode || focusCode) : datum.Highlight) ? 3 : 1.5"
          },
          "opacity": {
            "signal": "!(hoverCode || focusCode) || datum.Code === (hoverCode || focusCode) ? 1 : 0.45"
          },
          "tooltip": {
            "signal": "{'Subdivision':datum.Subdivision,'2023\u201324 IVA (A$ million)':format(datum.IVA_2023_24,',.0f'),'2024\u201325 IVA (A$ million)':format(datum.IVA_2024_25,',.0f'),'Absolute change (A$ million)':format(datum.Absolute_Change,'+,.0f'),'Percentage change':datum.Percentage_Display,'Unit':datum.Unit}"
          }
        }
      }
    },
    {
      "type": "rule",
      "from": {
        "data": "iva"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "240"
